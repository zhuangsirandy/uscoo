# Optional AI drafting. Configure hosted secrets through Sites runtime settings.
# Never commit a real key. Keep blank to run without AI-assisted drafting.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MODEL_DAILY_LIMIT=20

# Optional transactional email through Resend. Keep both blank to disable email.
RESEND_API_KEY=

# Example: USCOO <reports@example.org>
USCOO_EMAIL_FROM=

# Comma-separated Sites authenticated user IDs allowed to view /admin.
USCOO_ADMIN_USER_IDS=
